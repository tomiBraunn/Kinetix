# Kinetix backend — variables de entorno
# Copiar a ../.env (raíz del repo): server.js y test.js cargan dotenv desde ahí.

# Servidor
PORT=3000

# Supabase (project_ref: ihnvurzeuenwymqqyejz)
SUPABASE_URL=https://ihnvurzeuenwymqqyejz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT (cambiar en producción)
JWT_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL del frontend (usada en los links de verificación / reset)
FRONTEND_URL=http://localhost:5173

# Email de verificación de cuenta / reset de password — lo envía Supabase
# Auth (GoTrue), no el backend. Para que salga desde Gmail hay que configurar
# Custom SMTP en el Dashboard de Supabase (Authentication → Emails → SMTP
# Settings) con esa cuenta y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords), y pegar el HTML de
# email-templates/confirm-signup.html y reset-password.html en las plantillas
# "Confirm signup" y "Reset password" (nada de esto se configura acá).

# Mail de bienvenida al registrarse con Google — este sí lo manda el backend
# directo (nodemailer/mailer.js), porque no es una plantilla de Auth de
# Supabase. Misma cuenta y misma contraseña de aplicación que arriba.
GMAIL_USER=
GMAIL_APP_PASSWORD=
