  "email": "incompleto@test.com"
}

### Me (replace TOKEN with a real JWT)
GET http://localhost:3000/api/auth/me
Authorization: Bearer TOKEN

### Refresh (replace TOKEN)
POST http://localhost:3000/api/auth/refresh
Authorization: Bearer TOKEN

### Me without token
GET http://localhost:3000/api/auth/me

### Me with invalid token
GET http://localhost:3000/api/auth/me
Authorization: Bearer invalid-token-here

### Google callback (replace ID_TOKEN)
POST http://localhost:3000/api/auth/google/callback
Content-Type: application/json

{
  "id_token": "ID_TOKEN"
}

### Google callback missing id_token
POST http://localhost:3000/api/auth/google/callback
Content-Type: application/json

{}

### GitHub callback (replace CODE)
POST http://localhost:3000/api/auth/github/callback
Content-Type: application/json

{
  "code": "CODE"
}

### GitHub callback missing code
POST http://localhost:3000/api/auth/github/callback
Content-Type: application/json

{}
